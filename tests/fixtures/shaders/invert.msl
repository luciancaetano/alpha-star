#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_Params
{
    float amount;
};

struct main0_out
{
    float4 out_var_SV_Target [[color(0)]];
};

struct main0_in
{
    float4 in_var_COLOR0 [[user(locn0)]];
    float2 in_var_TEXCOORD0 [[user(locn1)]];
};

fragment main0_out main0(main0_in in [[stage_in]], constant type_Params& Params [[buffer(0)]], texture2d<float> u_texture [[texture(0)]], sampler u_sampler [[sampler(0)]])
{
    main0_out out = {};
    float4 _37 = u_texture.sample(u_sampler, in.in_var_TEXCOORD0) * in.in_var_COLOR0;
    float3 _38 = _37.xyz;
    out.out_var_SV_Target = float4(mix(_38, float3(1.0) - _38, float3(Params.amount)), _37.w);
    return out;
}

