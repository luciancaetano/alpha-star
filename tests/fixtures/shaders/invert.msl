#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct Params
{
    float amount;
};

struct main0_out
{
    float4 o_color [[color(0)]];
};

struct main0_in
{
    float4 v_color [[user(locn0)]];
    float2 v_uv [[user(locn1)]];
};

fragment main0_out main0(main0_in in [[stage_in]], constant Params& _36 [[buffer(0)]], texture2d<float> u_texture [[texture(0)]], sampler u_textureSmplr [[sampler(0)]])
{
    main0_out out = {};
    float4 c = u_texture.sample(u_textureSmplr, in.v_uv) * in.v_color;
    out.o_color = float4(mix(c.xyz, float3(1.0) - c.xyz, float3(_36.amount)), c.w);
    return out;
}

