{
  "version": 6,
  "configurePresets": [
    {
      "name": "dev",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "ALPHA_COVERAGE": "ON",
        "ALPHA_DEVTOOLS": "ON", "ALPHA_MCP": "ON", "ALPHA_DEBUG_TOOLS": "ON" }
    },
    {
      "name": "harness",
      "description": "Core + tests only, no runtime deps (fast gate)",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/harness",
      "cacheVariables": { "ALPHA_WITH_RUNTIME_DEPS": "OFF" }
    },
    {
      "name": "release",
      "description": "Optimized engine for alpha run/test/mcp: debug CLI + test runner + agent control + dev tools (F12)",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "ALPHA_BUILD_TESTS": "OFF",
        "ALPHA_DEVTOOLS": "ON", "ALPHA_MCP": "ON", "ALPHA_DEBUG_TOOLS": "ON", "ALPHA_SHIPPING": "OFF" }
    },
    {
      "name": "shipping",
      "description": "Player build (alpha export --standalone): no dev/debug/agent features, LTO, stripped, no console",
      "binaryDir": "${sourceDir}/build/shipping",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "ALPHA_BUILD_TESTS": "OFF", "ALPHA_SHIPPING": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev", "configuration": "Debug" },
    { "name": "harness", "configurePreset": "harness", "configuration": "Debug" },
    { "name": "release", "configurePreset": "release", "configuration": "Release" },
    { "name": "shipping", "configurePreset": "shipping", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "dev", "configurePreset": "dev", "configuration": "Debug",
      "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "harness", "configurePreset": "harness", "configuration": "Debug",
      "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } }
  ]
}
