{
  "name": "@alpha-star/sdk",
  "version": "0.1.0",
  "description": "Types and CLI for alpha-star games: check, export packs (JS + assets), run.",
  "type": "module",
  "bin": {
    "alpha": "bin/alpha.mjs"
  },
  "exports": {
    ".": "./lib/build.mjs",
    "./pack": "./lib/pack.mjs",
    "./tsconfig.json": "./tsconfig.game.json",
    "./engine": "./lib/engine.mjs"
  },
  "types": "./types/alpha.d.ts",
  "files": [
    "bin",
    "lib",
    "types",
    "engine",
    "notices",
    "tsconfig.game.json"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "esbuild": "0.25.0",
    "typescript": "5.8.2",
    "zod": "3.25.76"
  }
}
