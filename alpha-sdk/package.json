{
  "name": "@alpha-star/sdk",
  "version": "0.6.0",
  "description": "Types and CLI for alpha-star games: check, export packs (JS + assets), run.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luciancaetano/alpha-star.git",
    "directory": "alpha-sdk"
  },
  "bin": {
    "alpha": "bin/alpha.mjs"
  },
  "exports": {
    ".": "./lib/build.mjs",
    "./pack": "./lib/pack.mjs",
    "./tsconfig.json": "./tsconfig.game.json",
    "./engine": "./lib/engine.mjs",
    "./png": "./lib/png.mjs"
  },
  "types": "./types/alpha.d.ts",
  "license": "MIT",
  "files": [
    "bin",
    "android",
    "lib",
    "types",
    "notices",
    "templates",
    "llm",
    "skills",
    "tsconfig.game.json"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "templates": "node scripts/sync-templates.mjs",
    "docs": "node scripts/make-docs.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "esbuild": "0.25.0",
    "typescript": "5.8.2",
    "zod": "3.25.76"
  },
  "optionalDependencies": {
    "@alpha-star/engine-android-arm64": "0.6.0",
    "@alpha-star/engine-linux-x64": "0.6.0",
    "@alpha-star/engine-win32-x64": "0.6.0"
  }
}
