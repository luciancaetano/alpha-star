/* Orbital console. Native typography stays sharp and localized. */
body {
  width: 100%;
  height: 100%;
  box-sizing: border-box; /* class="safe": the engine pads it by ctx.safeArea */
  font-family: pixel;
  font-size: 10dp;
  color: #edf5ff;
  text-align: center;
}
.shadow { font-effect: shadow(2dp 3dp #080b24); }
h1 { display: block; font-size: 28dp; color: #f3eeff; }
p { display: block; }
.eyebrow { display: block; color: #7aeaff; font-size: 7dp; letter-spacing: 2dp; }
.panel {
  display: block;
  width: 216dp;
  margin: 142dp auto 0dp auto;
  padding: 20dp 12dp;
  background-color: #0c1334ed;
  border: 2dp #7b78c9;
  border-top: 3dp #78efff;
  border-radius: 12dp;
  color: #edf5ff;
}
.panel h1 { color: #baf6ff; font-size: 17dp; margin: 6dp 0dp 20dp; }
.row {
  display: block;
  margin: 8dp 0dp;
  padding: 10dp 4dp;
  background-color: #19234c;
  border-radius: 4dp;
  color: #bbbde8;
}
.row span { display: inline-block; }
.row #score, .row #best { color: #ffffff; margin-left: 10dp; }
button {
  display: block;
  width: 180dp;
  margin: 14dp auto 0dp auto;
  padding: 12dp 0dp;
  tab-index: auto;
  focus: auto;
  background-color: #3b2b78;
  border: 2dp #9387e2;
  border-radius: 6dp;
  color: #ffffff;
}
button:hover { background-color: #59449b; border-color: #b9afff; }
button:focus { background-color: #28506c; border-color: #86f5ff; }
button:active { background-color: #16394c; }
.high-contrast .panel { background-color: #000000; border-color: #ffffff; color: #ffffff; }
.high-contrast .panel h1, .high-contrast .eyebrow { color: #ffff00; }
.high-contrast .row { background-color: #000000; color: #ffffff; }
.high-contrast button { background-color: #000000; border-color: #ffffff; }
.high-contrast button:focus { background-color: #ffff00; color: #000000; }
