/* Shared look for every Flappy screen. font-family names come from assets.fonts in main.ts. */
body {
  width: 100%;
  height: 100%;
  font-family: pixel;
  font-size: 12dp;
  color: #ffffff;
  text-align: center;
}
.shadow { font-effect: shadow(2dp 2dp #2b2b2b); }
h1 { display: block; font-size: 28dp; color: #ffe066; }
p { display: block; }
.blink { animation: 1.2s cubic-in-out infinite alternate blink; }
@keyframes blink { from { opacity: 1; } to { opacity: 0.35; } }

.panel {
  display: block;
  width: 216dp;
  margin: 150dp auto 0dp auto;
  padding: 16dp 12dp;
  background-color: #ded895;
  border: 3dp #543847;
  border-radius: 6dp;
  color: #543847;
}
.panel h1 { color: #e86101; font-size: 20dp; margin-bottom: 14dp; }
.row { display: block; margin: 6dp 0dp; }

button {
  display: block;
  width: 160dp;
  margin: 16dp auto 0dp auto;
  padding: 10dp 0dp;
  tab-index: auto;
  focus: auto;
  background-color: #e86101;
  border: 3dp #ffffff;
  border-radius: 6dp;
  color: #ffffff;
}
button:hover { background-color: #ff8a2b; }
button:focus { background-color: #ff8a2b; border-color: #ffe066; }
button:active { background-color: #c04f00; }
