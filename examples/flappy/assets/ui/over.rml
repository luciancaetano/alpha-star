<rml>
<head>
  <link type="text/rcss" href="flappy.rcss"/>
</head>
<body class="safe">
  <div class="panel">
    <h1 data-t="over.title">GAME OVER</h1>
    <p class="row"><span data-t="over.score">SCORE</span> <span id="score">0</span></p>
    <p class="row"><span data-t="over.best">BEST</span> <span id="best">0</span></p>
    <button id="again" autofocus data-t="over.again">PLAY AGAIN</button>
  </div>
</body>
</rml>
