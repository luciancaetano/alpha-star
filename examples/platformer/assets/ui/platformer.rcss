/* Shared look of the platformer's screens; font-family names come from assets.fonts in main.ts. */
body { width: 100%; height: 100%; font-family: pixel; font-size: 8dp; color: #ffffff; }
.shadow { font-effect: shadow(1dp 1dp #2b2b2b); }
p { display: block; margin: 6dp 8dp; }
h1 { display: block; margin-top: 60dp; font-size: 16dp; color: #ffe066; text-align: center; }
.center { text-align: center; }
