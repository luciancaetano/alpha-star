/* No assets.fonts: every font-family falls back to the engine's built-in 8x8 font (sizes in multiples of 8). */
body { width: 100%; height: 100%; box-sizing: border-box; /* class="safe": padded by ctx.safeArea */ font-size: 8dp; color: #ffffff; }
p { display: block; margin: 4dp 12dp; }
.right { text-align: right; }
.panel { display: block; width: 200dp; margin: 60dp auto 0dp auto; padding: 12dp; background-color: #2c3e50; border: 2dp #ecf0f1; text-align: center; }
h1 { display: block; font-size: 16dp; color: #ffb347; margin-bottom: 8dp; }
button { display: block; margin-top: 10dp; padding: 6dp; background-color: #34495e; tab-index: auto; }
button:hover, button:focus { background-color: #e67e22; }
