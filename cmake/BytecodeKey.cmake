# game.jsbc key (core/bytecode.hpp): every flavor built from one checkout shares it, so the
# release engine (--compile encrypts) and the shipping engine (decrypts) of a staging match.
# Secret: -DALPHA_JSBC_SECRET / $ALPHA_JSBC_SECRET, else build/jsbc.secret in the checkout
# (gitignored, made once at random; Android builds from the same checkout read it too).
# The binary holds the key only split in two masked halves (no plain 32-byte literal);
# the secret itself never reaches it. Writes <out> with kKeyMask, kKeyMasked, kKeyId.
function(alpha_bytecode_key out)
  set(secret "${ALPHA_JSBC_SECRET}")
  if(NOT secret)
    set(secret "$ENV{ALPHA_JSBC_SECRET}")
  endif()
  if(NOT secret)
    set(file "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../build/jsbc.secret")
    if(NOT EXISTS "${file}")
      string(RANDOM LENGTH 64 ALPHABET 0123456789abcdef noise)
      string(TIMESTAMP now "%Y%m%d%H%M%S%f")
      string(SHA256 fresh "${noise}${now}${CMAKE_BINARY_DIR}${CMAKE_HOST_SYSTEM_NAME}")
      file(WRITE "${file}" "${fresh}\n")
    endif()
    file(STRINGS "${file}" secret LIMIT_COUNT 1)
  endif()
  string(SHA256 key "alpha-star game.jsbc key|${secret}")
  string(SHA256 mask "alpha-star game.jsbc mask|${secret}")
  string(SHA256 id "alpha-star game.jsbc id|${secret}")
  string(SUBSTRING "${id}" 0 16 id)
  set(masked "")
  set(plain_mask "")
  foreach(i RANGE 0 62 2)
    string(SUBSTRING "${key}" ${i} 2 k)
    string(SUBSTRING "${mask}" ${i} 2 m)
    math(EXPR x "0x${k} ^ 0x${m}" OUTPUT_FORMAT HEXADECIMAL)
    string(APPEND masked "${x},")
    string(APPEND plain_mask "0x${m},")
  endforeach()
  file(CONFIGURE OUTPUT "${out}" CONTENT
       "// Generated by cmake/BytecodeKey.cmake; never commit.\nstatic const volatile unsigned char kKeyMask[32] = {${plain_mask}};\nstatic const volatile unsigned char kKeyMasked[32] = {${masked}};\nstatic const char kKeyId[] = \"${id}\";\n")
endfunction()
